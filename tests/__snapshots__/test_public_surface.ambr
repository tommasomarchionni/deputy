# serializer version: 1
# name: test_each_command_help_is_stable[bench]
  '''
  usage: deputy bench [-h] [--backend BACKEND] [--runs RUNS] [--tasks TASKS]
                      [--lessons] [--run-code] [--slow] [--variant VARIANT]
                      [--tasks-file TASKS_FILE] [--workdir WORKDIR]
                      [--compare BEFORE AFTER] [--fail-on-regression] [--json]
  
  options:
    -h, --help            show this help message and exit
    --backend BACKEND     backend name (default: the default backend)
    --runs RUNS           repetitions of the suite
    --tasks TASKS         comma-separated task names
    --lessons             apply the learned lessons (by default the benchmark
                          measures the raw model)
    --run-code            also run tasks whose grader executes model-written
                          code (in a temp directory)
    --slow                also run tasks that take minutes (a file larger than
                          the context)
    --variant VARIANT     extra setting: NAME=JSON
    --tasks-file TASKS_FILE
                          run the tasks of this TOML file on your own folder
    --workdir WORKDIR     folder for --tasks-file
    --compare BEFORE AFTER
                          compare two reports made with `deputy bench --json`;
                          runs nothing
    --fail-on-regression  with --compare: exit 1 when the second report is worse
    --json                print JSON, not a table
  
  '''
# ---
# name: test_each_command_help_is_stable[discover]
  '''
  usage: deputy discover [-h] [--project PROJECT] [--transcripts TRANSCRIPTS]
                         [--days DAYS] [--json]
  
  options:
    -h, --help            show this help message and exit
    --project PROJECT     project folder (default: here)
    --transcripts TRANSCRIPTS
                          a folder of session transcripts (*.jsonl)
    --days DAYS           how far back to look (default 30)
    --json                print JSON, not a table
  
  '''
# ---
# name: test_each_command_help_is_stable[doctor]
  '''
  usage: deputy doctor [-h]
  
  options:
    -h, --help  show this help message and exit
  
  '''
# ---
# name: test_each_command_help_is_stable[hook]
  '''
  usage: deputy hook [-h] {on,off,status,read-hint}
  
  positional arguments:
    {on,off,status,read-hint}
  
  options:
    -h, --help            show this help message and exit
  
  '''
# ---
# name: test_each_command_help_is_stable[init]
  '''
  usage: deputy init [-h] [--name NAME] [--url URL] [--model MODEL]
                     [--key-file KEY_FILE] [--force] [--confine] [--yes]
  
  options:
    -h, --help           show this help message and exit
    --name NAME
    --url URL
    --model MODEL
    --key-file KEY_FILE
    --force
    --confine            run `command` checks inside an OS sandbox
    --yes                never ask; use flags and defaults
  
  '''
# ---
# name: test_each_command_help_is_stable[install]
  '''
  usage: deputy install [-h] [--apply] [--no-hook] [--no-skill]
                        {claude-code,vscode,cursor,codex,generic}
  
  positional arguments:
    {claude-code,vscode,cursor,codex,generic}
  
  options:
    -h, --help            show this help message and exit
    --apply               do it instead of printing
    --no-hook             claude-code: do not add the hint that suggests
                          delegating large reads
    --no-skill            claude-code: do not install the delegation guide as a
                          user-level skill
  
  '''
# ---
# name: test_each_command_help_is_stable[instructions]
  '''
  usage: deputy instructions [-h]
                             [--for {agents,claude,claude-md,copilot,copilot-repo,cursor}]
                             [--apply] [--write FILE]
  
  options:
    -h, --help            show this help message and exit
    --for {agents,claude,claude-md,copilot,copilot-repo,cursor}
                          the format of this agent: claude: a Claude Code skill:
                          loaded only when relevant, so it costs no tokens
                          otherwise; claude-md: always loaded by Claude Code;
                          copilot: a GitHub Copilot instructions file; copilot-
                          repo: GitHub Copilot repository instructions; cursor:
                          a Cursor rule the agent attaches when relevant;
                          agents: read by Codex, Copilot and many other agents
    --apply               with --for: write it where the agent reads it
    --write FILE          insert the guide as a marked block in FILE
  
  '''
# ---
# name: test_each_command_help_is_stable[learn]
  '''
  usage: deputy learn [-h] [--days DAYS] [--apply]
  
  options:
    -h, --help   show this help message and exit
    --days DAYS  how far back to look
    --apply      save the lessons
  
  '''
# ---
# name: test_each_command_help_is_stable[lessons]
  '''
  usage: deputy lessons [-h] [--backend BACKEND] [--runs RUNS] [--apply]
                        [{list,remove,check}] [id]
  
  positional arguments:
    {list,remove,check}
    id                   the lesson to remove (profile:check)
  
  options:
    -h, --help           show this help message and exit
    --backend BACKEND    check: the backend to test on
    --runs RUNS          check: repetitions per side
    --apply              check: remove the lessons that hurt
  
  '''
# ---
# name: test_each_command_help_is_stable[mcp]
  '''
  usage: deputy mcp [-h]
  
  options:
    -h, --help  show this help message and exit
  
  '''
# ---
# name: test_each_command_help_is_stable[memory]
  '''
  usage: deputy memory [-h] [--repo REPO] [--apply]
                       [{show,export,scan,pointer,term,remove}] [key] [text]
  
  positional arguments:
    {show,export,scan,pointer,term,remove}
    key                   pointer: a file; term: the word; remove: either
    text                  pointer: why it matters; term: what it means
  
  options:
    -h, --help            show this help message and exit
    --repo REPO           a folder inside the repository (default: here)
    --apply               scan: remember what it finds
  
  '''
# ---
# name: test_each_command_help_is_stable[optimise]
  '''
  usage: deputy optimise [-h] [--backend BACKEND] [--profile PROFILE]
                         [--runs RUNS] [--list] [--apply ID] [--revert ID]
  
  options:
    -h, --help         show this help message and exit
    --backend BACKEND  backend name (default: the default backend)
    --profile PROFILE  the profile to improve
    --runs RUNS        repetitions of each measurement
    --list             list saved proposals
    --apply ID         install a confirmed proposal
    --revert ID        undo an applied proposal
  
  '''
# ---
# name: test_each_command_help_is_stable[stats]
  '''
  usage: deputy stats [-h] [--days DAYS] [--json] [--include-bench]
  
  options:
    -h, --help       show this help message and exit
    --days DAYS      how far back to look (default 30)
    --json           print JSON, not a table
    --include-bench  also count benchmark runs (synthetic)
  
  '''
# ---
# name: test_each_command_help_is_stable[tune]
  '''
  usage: deputy tune [-h] [--backend BACKEND] [--runs RUNS] [--tasks TASKS]
                     [--lessons] [--run-code] [--apply] [--revert]
  
  options:
    -h, --help         show this help message and exit
    --backend BACKEND  backend name (default: the default backend)
    --runs RUNS        repetitions of the suite
    --tasks TASKS      comma-separated task names
    --lessons          apply the learned lessons (by default the benchmark
                       measures the raw model)
    --run-code         also run tasks whose grader executes model-written code
                       (in a temp directory)
    --apply            write the winner
    --revert           undo the last tuning
  
  '''
# ---
# name: test_each_command_help_is_stable[update]
  '''
  usage: deputy update [-h] [--check] [--require-verified]
  
  options:
    -h, --help          show this help message and exit
    --check             only look, change nothing
    --require-verified  refuse unless the release provenance could be verified
                        (needs gh, logged in)
  
  '''
# ---
# name: test_each_command_help_is_stable[workspace]
  '''
  usage: deputy workspace [-h] [--repo REPO]
                          {create,diff,path,remove} name [paths ...]
  
  positional arguments:
    {create,diff,path,remove}
    name
    paths                 files or folders to copy (create only)
  
  options:
    -h, --help            show this help message and exit
    --repo REPO           repository the paths are relative to
  
  '''
# ---
# name: test_the_benchmark_table_is_stable
  '''
  variant            pass  cites  turns  tok out  ±tok     sec  ±sec  tok/s  saved*
  baseline            80%   100%    2.4      912     0    61.5   7.2   14.8    1530
  thinking-off        80%   100%    2.2      311     0    24.0   3.1   13.0    1530
  * saved: estimated tokens the orchestrator did not have to read (chars / 4)
  '''
# ---
# name: test_the_list_of_commands_is_stable
  list([
    'bench',
    'discover',
    'doctor',
    'hook',
    'init',
    'install',
    'instructions',
    'learn',
    'lessons',
    'mcp',
    'memory',
    'optimise',
    'stats',
    'tune',
    'update',
    'workspace',
  ])
# ---
# name: test_the_server_instructions_are_stable
  'Saves your context: a cheaper model reads files for you. Before you read a file over about 8 KB, or several files, to answer a question, summarise, compare or find facts, call `digest` with the files and the question instead of reading them. If its status is ok, work from the answer: deputy proved that each quoted source is on its line, not that the model understood it, so read the cited line before you act on a fact. If the status is not ok, read the files yourself. Read directly a file you are about to edit, a short file, or what one search answers. For other work with your own checks, use `delegate`.'
# ---
# name: test_the_tool_schemas_are_stable
  '''
  {
    "collect": {
      "description": "Result of a `wait=False` delegation (waits up to 20 s); cancel=True stops it.",
      "input": {
        "properties": {
          "cancel": {
            "default": false,
            "title": "Cancel",
            "type": "boolean"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "collectArguments",
        "type": "object"
      }
    },
    "delegate": {
      "description": "Run a task on a worker in the absolute `workdir`, verified by `checks`. wait=False returns at once; then use `collect`.",
      "input": {
        "$defs": {
          "CheckSpec": {
            "properties": {
              "argv": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "json_schema": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "limit": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "max": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "min": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "type": {
                "enum": [
                  "contains",
                  "excludes",
                  "cites_lines",
                  "cites_text",
                  "json_schema",
                  "max_chars",
                  "file_written",
                  "file_contains",
                  "command"
                ],
                "type": "string"
              },
              "values": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "type"
            ],
            "title": "CheckSpec",
            "type": "object"
          }
        },
        "properties": {
          "backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Backend"
          },
          "checks": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/CheckSpec"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Checks"
          },
          "max_turns": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Turns"
          },
          "profile": {
            "default": "helper",
            "title": "Profile",
            "type": "string"
          },
          "task": {
            "title": "Task",
            "type": "string"
          },
          "wait": {
            "default": true,
            "title": "Wait",
            "type": "boolean"
          },
          "workdir": {
            "title": "Workdir",
            "type": "string"
          }
        },
        "required": [
          "task",
          "workdir"
        ],
        "title": "delegateArguments",
        "type": "object"
      }
    },
    "digest": {
      "description": "Ask about files in the absolute `workdir` instead of reading them: a short answer, every line citing a proven file line.",
      "input": {
        "properties": {
          "files": {
            "items": {
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "workdir": {
            "title": "Workdir",
            "type": "string"
          }
        },
        "required": [
          "files",
          "question",
          "workdir"
        ],
        "title": "digestArguments",
        "type": "object"
      }
    },
    "feedback": {
      "description": "Report whether a result was good.",
      "input": {
        "properties": {
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "verdict": {
            "enum": [
              "accepted",
              "rejected"
            ],
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "verdict"
        ],
        "title": "feedbackArguments",
        "type": "object"
      }
    },
    "profiles": {
      "description": "Available profiles (name: description).",
      "input": {
        "properties": {
          "workdir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Workdir"
          }
        },
        "title": "profilesArguments",
        "type": "object"
      }
    },
    "status": {
      "description": "Backends and whether they answer.",
      "input": {
        "properties": {},
        "title": "statusArguments",
        "type": "object"
      }
    }
  }
  '''
# ---
